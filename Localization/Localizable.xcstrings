      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 个会话"
          }
        }
      }
    },
    "%lld sessions with open terminals and %lld sessions from tools JustSessions can't delete will be skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld sessions with open terminals and %2$lld sessions from tools JustSessions can't delete will be skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 %lld 个终端已打开的会话，以及 %lld 个尚不支持删除的工具会话。"
          }
        }
      }
    },
    "%lld sessions with open terminals and 1 session from tools JustSessions can't delete will be skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 %lld 个终端已打开的会话，以及 1 个尚不支持删除的工具会话。"
          }
        }
      }
    },
    "%lld sessions with open terminals will be skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 %lld 个终端已打开的会话。"
          }
        }
      }
    },
    "%lld tool calls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次工具调用"
          }
        }
      }
    },
    "**Install tmux on the host** so sessions survive a dropped connection or a closed tab. Built-in tmux is only for this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**在远程主机上安装 tmux**，让会话在断线或关闭标签后继续运行。内置 tmux 仅用于本机。"
          }
        }
      }
    },
    ", %lld sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，%lld 个会话"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": ", %lld session"
