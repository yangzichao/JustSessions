    "Applies immediately to all terminals. Some CLI apps use their own colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即应用到所有终端。部分 CLI 应用使用自己的配色。"
