      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac"
          }
        }
      }
    },
    "This affects all tools in %@, including sessions hidden by the current filter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会影响 %@ 中所有工具的会话，包括被当前筛选条件隐藏的会话。"
          }
        }
      }
    },
    "This changes the display name in JustSessions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅修改 JustSessions 中的显示名称。"
          }
        }
      }
    },
    "This changes the display name in JustSessions. The folder stays the same. Leave empty to use the folder name (%@).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 JustSessions 中的显示名称，文件夹保持原样。留空可使用文件夹名称（%@）。"
          }
        }
      }
    },
    "This session will be permanently deleted on %@. SSH hosts have no Trash, so this cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的此会话将被永久删除。SSH 主机没有废纸篓，此操作无法撤销。"
          }
        }
      }
    },
