    },
    "Add a server you reach with passwordless SSH to browse and resume its sessions here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一台可通过免密 SSH 连接的服务器，就能在这里浏览并继续它上面的会话。"
          }
        }
      }
    },
