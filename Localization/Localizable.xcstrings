    "Stopping deletion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止删除"
          }
        }
      }
    },
    "Stopping…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止…"
          }
        }
      }
    },
    "Subagent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理"
          }
        }
      }
    },
    "Subagent of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的子代理"
          }
        }
      }
    },
    "Subagents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理"
          }
        }
      }
    },
    "Supports local Claude Code, Codex, Pi, and OpenCode, including sessions running in tmux without an open tab. Sessions you are viewing do not notify you. Click a notification to open its session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持本机的 Claude Code、Codex、Pi 和 OpenCode，包括在 tmux 中运行但未打开标签的会话。正在查看的会话不发送通知。点击通知可打开会话。"
          }
        }
      }
    },
    "Swap with left view": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与左侧视图交换"
          }
        }
      }
    },
    "Swap with right view": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与右侧视图交换"
          }
        }
      }
    },
    "Switches between a readable width and the full window width": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在适合阅读的宽度和窗口全宽之间切换"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "System Monospaced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统等宽字体"
          }
        }
      }
    },
    "System Monospaced can't show the included Nerd Font icons. To see them, as in shell prompts, choose another font, such as Menlo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统等宽字体无法显示内置的 Nerd Font 图标。若要显示这些图标（例如 shell 提示符中的图标），请选择其他字体，例如 Menlo。"
          }
        }
      }
    },
    "Tab %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签 %lld"
          }
        }
      }
    },
    "Tabs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签"
          }
        }
      }
    },
    "Tabs and split view": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页与拆分视图"
          }
        }
      }
    },
    "Tabs and windows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
