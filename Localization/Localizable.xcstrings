      }
    },
    "macOS asks for these on behalf of JustSessions, also when a CLI in one of its terminals needs one. Checking here never shows a prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 以 JustSessions 的名义请求这些权限，终端中的 CLI 需要时也是如此。在这里检查不会弹出任何请求。"
          }
        }
      }
    },
    "macOS asks the first time JustSessions needs it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在 JustSessions 第一次需要时询问。"
          }
        }
      }
    },
    "macOS doesn't let apps check this. Look for JustSessions in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许应用检查这项权限。请在系统设置中找到 JustSessions。"
