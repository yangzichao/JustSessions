            "value": "所有工具"
          }
        }
      }
    },
    "Allow JustSessions in macOS Login Items to finish enabling automatic launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 macOS 的“登录项”中允许 JustSessions，以完成自动启动设置。"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Also resumes %@ sessions on %@. JustSessions adds its own arguments after it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Also resumes %1$@ sessions on %2$@. JustSessions adds its own arguments after it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 上恢复 %1$@ 会话时也会用它。JustSessions 会在它后面加上自己的参数。"
          }
        }
      }
    },
    "Also resumes %@ sessions on this Mac. JustSessions adds its own arguments after it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上恢复 %@ 会话时也会用它。JustSessions 会在它后面加上自己的参数。"
          }
        }
      }
    },
    "An archived project is hidden from the sidebar. Its folder and sessions stay on disk, and restoring it lists them again. Starting a new session in its folder also restores it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的项目会从侧栏中隐藏。其文件夹和会话仍保留在磁盘上，恢复后会重新列出。在其文件夹中新建会话也会恢复该项目。"
          }
        }
      }
    },
    "Antigravity and OpenCode need `python3`; deleting Antigravity sessions also needs `lsof`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity 和 OpenCode 需要 `python3`；删除 Antigravity 会话还需要 `lsof`。"
          }
        }
      }
    },
    "App": {
      "localizations": {
