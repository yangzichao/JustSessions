    "%@ will permanently delete this session using its native CLI. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将通过原生 CLI 永久删除此会话。此操作无法撤销。"
          }
        }
      }
    },
    "%@ · %@ · %@%@": {
      "shouldTranslate": false
    },
