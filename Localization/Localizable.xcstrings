        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目仍会保留在侧栏中。"
          }
        }
      }
    },
    "The shell and anything still running in it will stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "shell 及其中仍在运行的进程都会停止。"
          }
        }
      }
    },
    "The terminal process will stop. Sessions saved by the CLI will appear in the project list after refresh.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端进程会停止。CLI 已保存的会话将在刷新后出现在项目列表中。"
          }
        }
      }
    },
