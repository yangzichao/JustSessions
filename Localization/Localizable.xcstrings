            "value": "使用窗口全宽"
          }
        }
      }
    },
    "Use this host's tmux prefix": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此主机的 tmux 前缀键"
          }
        }
      }
    },
    "User guide ↗": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户指南 ↗"
          }
        }
      }
    },
    "Waiting for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待我处理"
          }
        }
      }
    },
    "Website ↗": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站 ↗"
          }
        }
      }
    },
    "When you close a tab": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签时"
          }
        }
      }
    },
    "When you close this tab, choose **Keep running**: the CLI carries on, even after you quit. Click its session to return.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这个标签页时选择 **保持运行**：CLI 会继续运行，退出 App 后也不会停。单击它的会话即可回来。"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "Your login shell, with no CLI": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的登录 shell，不运行 CLI"
          }
        }
      }
    },
    "Your sessions will appear here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会话会显示在这里"
          }
        }
      }
    },
    "Your sessions, already here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会话已经在这里"
          }
        }
      }
    },
    "Your shell startup keeps CLIs from starting!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 shell 启动配置使 CLI 无法启动！"
          }
        }
      }
    },
    "`python3`, for Antigravity and OpenCode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`python3`，用于 Antigravity 和 OpenCode"
          }
        }
      }
    },
    "`rsync`, and the CLIs you use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`rsync`，以及你使用的 CLI"
          }
        }
      }
    },
    "`tmux`, so a CLI keeps running when the connection drops": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`tmux`，这样连接断开时 CLI 也会继续运行"
          }
        }
      }
    },
    "iTerm2 Color Preset File…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 配色预设文件…"
          }
        }
      }
    },
    "iTerm2 Default Profile": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 默认 Profile"
          }
        }
      }
    },
    "iTerm2 has no saved settings on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上没有 iTerm2 的设置。"
          }
        }
      }
    },
    "macOS asks for these on behalf of JustSessions, also when a CLI in one of its terminals needs one. Checking here never shows a prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 以 JustSessions 的名义请求这些权限，终端中的 CLI 需要时也是如此。在这里检查不会弹出任何请求。"
          }
        }
      }
    },
    "macOS asks the first time JustSessions needs it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在 JustSessions 第一次需要时询问。"
          }
        }
      }
    },
    "macOS doesn't let apps check this. Look for JustSessions in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许应用检查这项权限。请在系统设置中找到 JustSessions。"
          }
        }
      }
    },
    "·": {
      "shouldTranslate": false
    },
    "⇧-click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ 点击"
          }
        }
      }
    },
    "⌘-click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 点击"
          }
        }
      }
    }
  },
  "version": "1.0"
}
