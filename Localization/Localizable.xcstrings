    "Check `tmux -V` on the host, then choose **Add SSH host…** in the sidebar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在远程主机上运行 `tmux -V`，然后在侧栏选择**添加 SSH 主机…**。"
          }
        }
      }
    },
    "Check for updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        }
      }
    },
    "Checking the folder on %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查 %@ 上的文件夹…"
          }
        }
