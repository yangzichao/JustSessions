        }
      }
    },
    "%@ · %@ · %@%@": {
      "shouldTranslate": false
    },
    "%@ · ⌘-click to select multiple projects; Shift-click to select a range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 按住 ⌘ 点击选择多个项目；按住 Shift 点击选择一个范围"
