    },
    "1 session with an open terminal and %lld sessions from tools JustSessions can't delete will be skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 1 个终端已打开的会话，以及 %lld 个尚不支持删除的工具会话。"
          }
        }
      }
    },
    "1 session with an open terminal and 1 session from tools JustSessions can't delete will be skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 1 个终端已打开的会话，以及 1 个尚不支持删除的工具会话。"
