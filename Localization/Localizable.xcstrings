    "%@ %@": {
      "shouldTranslate": false
    },
    "%@ %@ — %@": {
      "shouldTranslate": false
    },
    "%@ could not be refreshed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新 %@：%@"
          }
        }
      }
    },
    "%@ has not saved this session yet · click to open its terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未保存此会话 · 点击打开终端"
          }
        }
      }
    },
    "%@ tab group": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 标签组"
          }
        }
      }
    },
    "%@ will permanently delete this session using its native CLI. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将通过原生 CLI 永久删除此会话。此操作无法撤销。"
          }
        }
      }
    },
    "%@ · %@ · %@%@": {
      "shouldTranslate": false
    },
    "%@ · ⌘-click to select multiple projects; Shift-click to select a range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 按住 ⌘ 点击选择多个项目；按住 Shift 点击选择一个范围"
          }
        }
      }
    },
