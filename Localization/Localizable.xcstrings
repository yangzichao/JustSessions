    "%lld earlier entries are not shown. Resume the session to see all of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未显示前面的 %lld 条记录。继续会话可查看全部内容。"
          }
        }
      }
    },
