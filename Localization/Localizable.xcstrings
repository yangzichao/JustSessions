    "All tools": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有工具"
          }
        }
      }
    },
    "All your CLIs in one place": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一管理各个 CLI"
          }
        }
      }
    },
    "Also: search, pin, rename, and export sessions as Markdown. Claude Code and Codex on this Mac can notify you when they finish or need input. Features vary by CLI.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还可搜索、置顶、重命名会话，并导出为 Markdown。本机的 Claude Code 和 Codex 可在完成任务或等待输入时通知你。各 CLI 支持的功能有所不同。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Applies immediately to all terminals. Some CLI apps use their own colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即应用到所有终端。部分 CLI 应用使用自己的配色。"
          }
        }
      }
    },
    "At launch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时"
          }
        }
