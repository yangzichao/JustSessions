    "%@, %@, open terminal, not saved yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@，终端已打开，尚未保存"
          }
        }
      }
    },
    "%@, by host and project. It reads the history they already save: no import, no account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按主机和项目浏览 %@ 的会话。直接读取现有历史记录，无需导入或注册。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
