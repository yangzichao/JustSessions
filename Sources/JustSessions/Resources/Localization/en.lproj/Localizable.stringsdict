			<string>Delete %lld sessions…</string>
		</dict>
	</dict>
	<key>Export %lld conversations</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Export %lld conversation</string>
			<key>other</key>
			<string>Export %lld conversations</string>
		</dict>
	</dict>
	<key>Resume %lld sessions</key>
